#!/usr/bin/python3
"""Create a consistent SQLite snapshot on NVMe; no container or I2C access."""
from pathlib import Path
import datetime,os,sqlite3
root=Path('/var/backups/pi-control/snapshots');root.mkdir(parents=True,exist_ok=True);root.chmod(0o700)
source=Path('/var/lib/pi-control/state/control.db')
if not source.is_file():raise SystemExit('Pi Control database does not exist')
target=root/(datetime.datetime.now(datetime.timezone.utc).strftime('%Y%m%d-%H%M%S')+'.sqlite')
os.umask(0o077)
with sqlite3.connect('file:'+str(source)+'?mode=ro',uri=True) as src:
    with sqlite3.connect(target) as dst:
        src.backup(dst)
        if dst.execute('PRAGMA quick_check').fetchone()[0]!='ok':raise SystemExit('Snapshot integrity check failed')
for old in sorted(root.glob('*.sqlite'),key=lambda p:p.name,reverse=True)[3:]:old.unlink()
print('Verified snapshot:',target)
