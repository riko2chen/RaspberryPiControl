{
  "name": "pi-control",
  "version": "1.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "dev:demo": "vite --mode demo --host 127.0.0.1",
    "build:demo": "tsc -b && vite build --mode demo",
    "preview:demo": "vite preview --mode demo --host 127.0.0.1",
    "test:demo": "node --experimental-strip-types --test ../tests/demo.test.mjs"
  },
  "dependencies": {
    "lucide-react": "1.48.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.20.4",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "0.186.0",
    "swagger-ui-dist": "5.33.0",
    "tailwindcss": "4.3.3",
    "typescript": "~5.9.3",
    "vite": "8.3.1"
  }
}
